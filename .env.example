# Chain Explorer — environment configuration
# Copy to .env and adjust values. All variables use the CHAIN_ prefix.

# --- Server ---
CHAIN_DEBUG=false
CHAIN_LOG_LEVEL=INFO
CHAIN_LOG_FORMAT=text
CHAIN_API_HOST=0.0.0.0
CHAIN_API_PORT=8000
CHAIN_CORS_ORIGINS=*

# --- Blockchain ---
CHAIN_INITIAL_DIFFICULTY=3
CHAIN_MINING_REWARD=10.0
CHAIN_MAX_MEMPOOL_SIZE=500
CHAIN_PERSISTENCE_ENABLED=true
CHAIN_DATA_DIR=data

# --- Frontend (optional — set in index.html meta or localStorage) ---
# Meta tag: <meta name="chain-api-url" content="http://localhost:8000">
# Debug: append ?debug=1 to the frontend URL or localStorage chain_debug=true
